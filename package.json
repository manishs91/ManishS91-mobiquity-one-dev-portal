{
  "name": "mobiquity-one-dev-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-serve developer portal for the Mobiquity One payment orchestration platform",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "spec:lint": "tsx scripts/lint-spec.ts openapi/mobiquity-one.json",
    "mock": "tsx mock-server/server.ts",
    "dev:all": "concurrently -n portal,mock -c blue,magenta \"npm run dev\" \"npm run mock\"",
    "check": "npm run typecheck && npm test && npm run spec:lint"
  },
  "dependencies": {
    "marked": "^15.0.0",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
