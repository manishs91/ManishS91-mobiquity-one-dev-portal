# ---------------------------------------------------------------------------
# Mobiquity One Developer Portal — environment configuration
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public URL of the portal (used in emails and redirects)
PORTAL_BASE_URL=http://localhost:3000

# 32+ random bytes, e.g. `openssl rand -base64 48`. Signs session cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# Encrypts stored sandbox client secrets at rest (AES-256-GCM). 32 bytes, base64.
# e.g. `openssl rand -base64 32`
CREDENTIALS_ENCRYPTION_KEY=

# Where the "Try it" console and dashboard send sandbox API calls.
# Local mock (npm run mock):      http://localhost:4010
# Mobiquity One test environment: https://<your-sandbox-host>
SANDBOX_API_BASE_URL=http://localhost:4010

# Production API base URL shown in docs and code samples (not called by the portal).
PRODUCTION_API_BASE_URL=https://api.mobiquity-one.com

# How sandbox credentials are issued:
#   local     — portal generates client id/secret and registers them with the mock server
#   mobiquity — portal calls the Mobiquity One merchant-onboarding/admin API (see src/lib/providers/mobiquity.ts)
CREDENTIALS_PROVIDER=local

# Only used when CREDENTIALS_PROVIDER=mobiquity
MOBIQUITY_ADMIN_API_URL=
MOBIQUITY_ADMIN_TENANT_ID=
MOBIQUITY_ADMIN_CLIENT_SECRET=

# Shared secret between portal and the local mock server (provisioning endpoint).
MOCK_ADMIN_SECRET=dev-mock-admin-secret

# Data store. "file" writes JSON to ./.data (dev only). Implement src/lib/store for Postgres etc.
STORE_DRIVER=file
STORE_FILE_PATH=.data/portal-db.json

# Signup policy: "open" (anyone gets sandbox instantly) or "allowlist" (only listed email domains)
SIGNUP_POLICY=open
SIGNUP_ALLOWED_DOMAINS=

# Comma-separated emails that get the internal "Admin" view (approve go-live requests)
PORTAL_ADMIN_EMAILS=
